APP_NAME=Libeflix
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://libeflix2.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_API_KEY=
TMDB_IMAGE_BASE_URL_92=https://image.tmdb.org/t/p/w92
TMDB_IMAGE_BASE_URL_185=https://image.tmdb.org/t/p/w185
TMDB_IMAGE_BASE_URL_300=https://image.tmdb.org/t/p/w300
TMDB_IMAGE_BASE_URL_500=https://image.tmdb.org/t/p/w500
TMDB_IMAGE_BASE_URL_780=https://image.tmdb.org/t/p/w780
TMDB_IMAGE_BASE_URL_1000=https://image.tmdb.org/t/p/w1000
TMDB_IMAGE_BASE_URL_ORIGINAL=https://image.tmdb.org/t/p/original
DEFAULT_POSTER_IMAGE_URL=https://drive-in-theatre.netlify.app/movieImages/default-movie.png
DEFAULT_EPISODE_STILL_IMAGE_URL="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQNK7-n-r_w_qCEIjsnu8VXMBamUkSmLUr9Eg&s"
DEFAULT_CREDIT_IMAGE_URL=/images/faceless.png

OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_REQUEST_TIMEOUT=30
OPENAI_RELEASE_YEAR_PROMPT="What is the release year (YYYY) of '**tvshowName**' tvshow? Give me the answer in a JSON format string like this: {tvshowName: string, releaseYear: integer}"